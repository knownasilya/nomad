{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "Stack": {
      "$ref": "#/$defs/Stack"
    },
    "Card": {
      "$ref": "#/$defs/Card"
    },
    "CardHeader": {
      "$ref": "#/$defs/CardHeader"
    },
    "Tabs": {
      "$ref": "#/$defs/Tabs"
    },
    "TabItem": {
      "$ref": "#/$defs/TabItem"
    },
    "Separator": {
      "$ref": "#/$defs/Separator"
    },
    "TextContent": {
      "$ref": "#/$defs/TextContent"
    },
    "Callout": {
      "$ref": "#/$defs/Callout"
    },
    "Tag": {
      "$ref": "#/$defs/Tag"
    },
    "TagBlock": {
      "$ref": "#/$defs/TagBlock"
    },
    "Steps": {
      "$ref": "#/$defs/Steps"
    },
    "StepsItem": {
      "$ref": "#/$defs/StepsItem"
    },
    "Stat": {
      "$ref": "#/$defs/Stat"
    },
    "Progress": {
      "$ref": "#/$defs/Progress"
    },
    "Table": {
      "$ref": "#/$defs/Table"
    },
    "Col": {
      "$ref": "#/$defs/Col"
    },
    "BarChart": {
      "$ref": "#/$defs/BarChart"
    },
    "HorizontalBarChart": {
      "$ref": "#/$defs/HorizontalBarChart"
    },
    "LineChart": {
      "$ref": "#/$defs/LineChart"
    },
    "AreaChart": {
      "$ref": "#/$defs/AreaChart"
    },
    "Series": {
      "$ref": "#/$defs/Series"
    },
    "PieChart": {
      "$ref": "#/$defs/PieChart"
    },
    "ScatterChart": {
      "$ref": "#/$defs/ScatterChart"
    },
    "ScatterSeries": {
      "$ref": "#/$defs/ScatterSeries"
    },
    "Point": {
      "$ref": "#/$defs/Point"
    },
    "Map": {
      "$ref": "#/$defs/Map"
    },
    "MapMarker": {
      "$ref": "#/$defs/MapMarker"
    },
    "Button": {
      "$ref": "#/$defs/Button"
    },
    "Buttons": {
      "$ref": "#/$defs/Buttons"
    }
  },
  "required": [
    "Stack",
    "Card",
    "CardHeader",
    "Tabs",
    "TabItem",
    "Separator",
    "TextContent",
    "Callout",
    "Tag",
    "TagBlock",
    "Steps",
    "StepsItem",
    "Stat",
    "Progress",
    "Table",
    "Col",
    "BarChart",
    "HorizontalBarChart",
    "LineChart",
    "AreaChart",
    "Series",
    "PieChart",
    "ScatterChart",
    "ScatterSeries",
    "Point",
    "Map",
    "MapMarker",
    "Button",
    "Buttons"
  ],
  "additionalProperties": false,
  "$defs": {
    "Stack": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {}
        },
        "direction": {
          "type": "string",
          "enum": ["row", "column"]
        },
        "gap": {
          "type": "string",
          "enum": ["none", "xs", "s", "m", "l", "xl"]
        },
        "align": {
          "type": "string",
          "enum": ["start", "center", "end", "stretch"]
        },
        "wrap": {
          "type": "boolean"
        }
      },
      "required": ["children"],
      "additionalProperties": false,
      "description": "Lays out children in a column (default) or a row"
    },
    "Card": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {}
        },
        "variant": {
          "type": "string",
          "enum": ["card", "sunk", "clear"]
        }
      },
      "required": ["children"],
      "additionalProperties": false,
      "description": "A bordered box that groups related content"
    },
    "CardHeader": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Title and optional subtitle at the top of a Card"
    },
    "Tabs": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TabItem"
          }
        }
      },
      "required": ["items"],
      "additionalProperties": false,
      "description": "Alternative views of the same subject, one visible at a time"
    },
    "TabItem": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "content": {
          "type": "array",
          "items": {}
        }
      },
      "required": ["value", "trigger", "content"],
      "additionalProperties": false,
      "description": "value is a unique id, trigger is the tab label"
    },
    "Separator": {
      "type": "object",
      "properties": {},
      "additionalProperties": false,
      "description": "A horizontal rule between sections"
    },
    "TextContent": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "enum": ["small", "default", "large", "small-heavy", "large-heavy"]
        }
      },
      "required": ["text"],
      "additionalProperties": false,
      "description": "A paragraph or a heading of plain text"
    },
    "Callout": {
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "enum": ["info", "warning", "error", "success", "neutral"]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": ["variant", "title", "description"],
      "additionalProperties": false,
      "description": "A colored notice with a title and a description"
    },
    "Tag": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "variant": {
          "type": "string",
          "enum": ["neutral", "info", "success", "warning", "danger"]
        }
      },
      "required": ["text"],
      "additionalProperties": false,
      "description": "A small colored badge"
    },
    "TagBlock": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["tags"],
      "additionalProperties": false,
      "description": "A row of neutral tags"
    },
    "Steps": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepsItem"
          }
        }
      },
      "required": ["items"],
      "additionalProperties": false,
      "description": "A numbered step-by-step guide"
    },
    "StepsItem": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      },
      "required": ["title", "details"],
      "additionalProperties": false,
      "description": "One numbered step"
    },
    "Stat": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "trend": {
          "type": "string",
          "enum": ["up", "down", "flat"]
        },
        "caption": {
          "type": "string"
        }
      },
      "required": ["label", "value"],
      "additionalProperties": false,
      "description": "A headline number (KPI). change is a short delta like \"+12%\"; trend colors it"
    },
    "Progress": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "required": ["label", "value"],
      "additionalProperties": false,
      "description": "A labelled bar showing value out of max (default 100)"
    },
    "Table": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Col"
          }
        }
      },
      "required": ["columns"],
      "additionalProperties": false,
      "description": "A table, column by column. Every Col has one value per row"
    },
    "Col": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {}
        },
        "type": {
          "type": "string",
          "enum": ["string", "number"]
        }
      },
      "required": ["label", "data"],
      "additionalProperties": false,
      "description": "One table column: a header and one value per row"
    },
    "BarChart": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Series"
          }
        },
        "variant": {
          "type": "string",
          "enum": ["grouped", "stacked"]
        },
        "xLabel": {
          "type": "string"
        },
        "yLabel": {
          "type": "string"
        }
      },
      "required": ["labels", "series"],
      "additionalProperties": false,
      "description": "Vertical bars: compare values across a few categories, one or more series"
    },
    "Series": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": ["category", "values"],
      "additionalProperties": false,
      "description": "One named series of numbers, one per label"
    },
    "HorizontalBarChart": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Series"
          }
        },
        "variant": {
          "type": "string",
          "enum": ["grouped", "stacked"]
        },
        "xLabel": {
          "type": "string"
        },
        "yLabel": {
          "type": "string"
        }
      },
      "required": ["labels", "series"],
      "additionalProperties": false,
      "description": "Horizontal bars: rankings, or categories with long names"
    },
    "LineChart": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Series"
          }
        },
        "variant": {
          "type": "string",
          "enum": ["linear", "step"]
        },
        "xLabel": {
          "type": "string"
        },
        "yLabel": {
          "type": "string"
        }
      },
      "required": ["labels", "series"],
      "additionalProperties": false,
      "description": "Lines over ordered labels (time): trends, one or more series"
    },
    "AreaChart": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Series"
          }
        },
        "variant": {
          "type": "string",
          "enum": ["overlap", "stacked"]
        },
        "xLabel": {
          "type": "string"
        },
        "yLabel": {
          "type": "string"
        }
      },
      "required": ["labels", "series"],
      "additionalProperties": false,
      "description": "Filled lines over time; \"stacked\" shows parts of a total"
    },
    "PieChart": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "variant": {
          "type": "string",
          "enum": ["pie", "donut"]
        }
      },
      "required": ["labels", "values"],
      "additionalProperties": false,
      "description": "Shares of one whole, at most 6 slices"
    },
    "ScatterChart": {
      "type": "object",
      "properties": {
        "datasets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScatterSeries"
          }
        },
        "xLabel": {
          "type": "string"
        },
        "yLabel": {
          "type": "string"
        }
      },
      "required": ["datasets"],
      "additionalProperties": false,
      "description": "X/Y points: correlation and clusters"
    },
    "ScatterSeries": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Point"
          }
        }
      },
      "required": ["name", "points"],
      "additionalProperties": false,
      "description": "A named set of points"
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "label": {
          "type": "string"
        }
      },
      "required": ["x", "y"],
      "additionalProperties": false,
      "description": "One x/y point; label names it in the tooltip"
    },
    "Map": {
      "type": "object",
      "properties": {
        "markers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapMarker"
          }
        },
        "route": {
          "type": "boolean"
        },
        "zoom": {
          "type": "number"
        }
      },
      "required": ["markers"],
      "additionalProperties": false,
      "description": "An OpenStreetMap map that fits its markers. route: true joins them in order (an itinerary)"
    },
    "MapMarker": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      },
      "required": ["lat", "lng", "label"],
      "additionalProperties": false,
      "description": "A place on a Map, in decimal degrees"
    },
    "Button": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ActionExpression"
        },
        "variant": {
          "type": "string",
          "enum": ["primary", "secondary", "tertiary"]
        }
      },
      "required": ["label"],
      "additionalProperties": false,
      "description": "A button. Without an action it sends its label to you"
    },
    "ActionExpression": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "open_url"
            },
            "url": {
              "type": "string"
            }
          },
          "required": ["type", "url"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "continue_conversation"
            },
            "context": {
              "type": "string"
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "params": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": ["type"],
          "additionalProperties": false
        }
      ]
    },
    "Buttons": {
      "type": "object",
      "properties": {
        "buttons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Button"
          }
        },
        "direction": {
          "type": "string",
          "enum": ["row", "column"]
        }
      },
      "required": ["buttons"],
      "additionalProperties": false,
      "description": "A group of Buttons"
    }
  }
}
