<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen search widget (NomadSearchWidgetProvider). Row one is the app's address bar:
     tap it for a new tab ready to type in; the chip names the Space it opens in and switches it;
     the robot opens the AI. Two rows tall, a chip for each Space searches in that Space. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="4dp">

  <LinearLayout
    android:id="@+id/nomad_widget_bar"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@drawable/nomad_widget_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="4dp">

    <ImageView
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:contentDescription="@string/nomad_widget_logo"
      android:src="@drawable/nomad_widget_logo" />

    <TextView
      android:id="@+id/nomad_widget_hint"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:singleLine="true"
      android:text="@string/nomad_widget_hint"
      android:textColor="@color/nomad_widget_text_muted"
      android:textSize="16sp" />

    <LinearLayout
      android:id="@+id/nomad_widget_space"
      android:layout_width="wrap_content"
      android:layout_height="36dp"
      android:layout_marginStart="8dp"
      android:background="@drawable/nomad_widget_chip"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/nomad_widget_space_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/nomad_widget_dot" />
      <TextView
        android:id="@+id/nomad_widget_space_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:maxWidth="96dp"
        android:singleLine="true"
        android:textColor="@color/nomad_widget_text_dim"
        android:textSize="13sp" />
    </LinearLayout>

    <ImageView
      android:id="@+id/nomad_widget_ai"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginStart="2dp"
      android:background="@drawable/nomad_widget_round"
      android:contentDescription="@string/nomad_widget_ai"
      android:tooltipText="@string/nomad_widget_ai"
      android:padding="12dp"
      android:scaleType="fitCenter"
      android:src="@drawable/nomad_widget_robot" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/nomad_widget_chips"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:visibility="gone">
    <LinearLayout
      android:id="@+id/nomad_widget_chip0"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_weight="1"
      android:layout_marginEnd="6dp"
      android:background="@drawable/nomad_widget_chip"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/nomad_widget_chip0_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/nomad_widget_dot" />
      <TextView
        android:id="@+id/nomad_widget_chip0_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/nomad_widget_text_dim"
        android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/nomad_widget_chip1"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_weight="1"
      android:layout_marginEnd="6dp"
      android:background="@drawable/nomad_widget_chip"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/nomad_widget_chip1_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/nomad_widget_dot" />
      <TextView
        android:id="@+id/nomad_widget_chip1_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/nomad_widget_text_dim"
        android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/nomad_widget_chip2"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_weight="1"
      android:layout_marginEnd="6dp"
      android:background="@drawable/nomad_widget_chip"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/nomad_widget_chip2_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/nomad_widget_dot" />
      <TextView
        android:id="@+id/nomad_widget_chip2_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/nomad_widget_text_dim"
        android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/nomad_widget_chip3"
      android:layout_width="0dp"
      android:layout_height="36dp"
      android:layout_weight="1"
      android:layout_marginEnd="0dp"
      android:background="@drawable/nomad_widget_chip"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/nomad_widget_chip3_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/nomad_widget_dot" />
      <TextView
        android:id="@+id/nomad_widget_chip3_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/nomad_widget_text_dim"
        android:textSize="13sp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
