@@ -0,0 +1,23 @@
+package com.reactnativecommunity.webview;
+
+import android.os.Message;
+import android.webkit.WebView;
+
+/**
+ * Nomad: lets the app handle a page's new windows and downloads itself (mobile/modules/nomad-webview-windows).
+ * Without it, a window.open() or target="_blank" link went to another app (Chrome), which broke
+ * sign-in popups: the page that opened one never heard back from it.
+ */
+public final class RNCWebViewHooks {
+    public interface Hooks {
+        /** Return true when the hook created the window (and sent resultMsg). */
+        boolean onCreateWindow(WebView view, boolean isDialog, boolean isUserGesture, Message resultMsg);
+
+        /** Return true when the hook handled the download, so it isn't saved to Downloads. */
+        boolean onDownloadStart(WebView view, String url, String userAgent, String contentDisposition, String mimetype, long contentLength);
+    }
+
+    public static volatile Hooks hooks = null;
+
+    private RNCWebViewHooks() {}
+}
